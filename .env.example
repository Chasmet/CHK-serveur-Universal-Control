# Use a private HTTPS URL once deployed. Do not append secrets in URL paths.
PUBLIC_BASE_URL=https://your-domain.example
PORT=8787
HOST=0.0.0.0
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
JWT_SECRET=REPLACE_WITH_64_RANDOM_CHARACTERS
DATA_FILE=./data/server.json

# Local open-source AI through Ollama (server must reach this host).
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b

# Optional existing CHK Android bridge; keep its capability URL secret.
# CHK_LEGACY_MCP_URL=https://example.supabase.co/functions/v1/chk-home-mcp-gateway/mcp/PRIVATE_CAPABILITY
